# Copy the ELF compiled offline from this exact immutable Cargo source.
ARG DONOR_BASE
FROM ${DONOR_BASE}
ARG SOURCE_COMMIT
ARG BINARY_SHA256
ARG DONOR_BASE
COPY target/release/ivanka /usr/local/bin/ivanka
RUN test "$(sha256sum /usr/local/bin/ivanka | cut -d ' ' -f1)" = "${BINARY_SHA256}" \
    && test -x /usr/local/bin/ivanka
LABEL org.ottojung.ivanka.source-commit="${SOURCE_COMMIT}"
LABEL org.ottojung.ivanka.binary-sha256="${BINARY_SHA256}"
LABEL org.ottojung.ivanka.execution="rust-direct-default-alternative-tail"
LABEL org.ottojung.ivanka.donor-base-image="${DONOR_BASE}"
LABEL org.opencontainers.image.source="https://github.com/ottojung/ivanka"
