# Experimental descendant of the pinned Ivanka/MiCall candidate, not IVA.
# The assembler, reference panel, and MiCall coverage threshold are unchanged.
ARG BASE_IMAGE=localhost/ivanka-micall-ivanka:milestone198-pinned
FROM ${BASE_IMAGE}
COPY benchmarks/conserved_pair_remap.py /tmp/ivanka_conserved_remap.py
COPY benchmarks/patch_micall_conserved_remap.py /tmp/patch_micall_conserved_remap.py
RUN python /tmp/patch_micall_conserved_remap.py /tmp/ivanka_conserved_remap.py \
    && rm /tmp/patch_micall_conserved_remap.py /tmp/ivanka_conserved_remap.py \
    && python -c 'from micall.core.ivanka_conserved_remap import project_remap; assert callable(project_remap)'
LABEL org.ottojung.ivanka.experimental.conserved-pair-remap="SAM-reference-identity-and-soft-clips; coverage-unchanged"
