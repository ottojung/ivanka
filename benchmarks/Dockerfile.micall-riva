FROM docker.io/library/rust:1.93-bookworm AS riva-builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked

FROM localhost/riva-micall-iva:base
COPY --from=riva-builder /src/target/release/riva /usr/local/bin/riva
COPY benchmarks/patch_micall_for_riva.py /tmp/patch_micall_for_riva.py
RUN python /tmp/patch_micall_for_riva.py && rm /tmp/patch_micall_for_riva.py
LABEL org.opencontainers.image.description="MiCall de novo with Riva substituted at IVA boundary; other stages unchanged"
