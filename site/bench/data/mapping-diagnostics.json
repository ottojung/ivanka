{
  "cases_measured": 0,
  "cohort": "Source-attested HXB2-derived synthetic MiCall",
  "expected_cases": 400,
  "metric_catalog": {
    "aligned_read_bases": {
      "denominator": "Count of aligned query bases in primary records.",
      "description": "Primary mapped nucleotide bases represented by CIGAR M, =, or X. Excludes soft clips, insertions, and hard clips.",
      "label": "Aligned primary-read bases",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "higher",
      "unit": "nt"
    },
    "clipped_read_fraction": {
      "denominator": "Soft-clipped primary reads / all mapped primary reads.",
      "description": "Fraction of primary mapped read alignments carrying one or more soft clips, counting each mapped primary record once.",
      "label": "Fraction of mapped reads clipped",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "fraction"
    },
    "deleted_reference_bases": {
      "denominator": "Count of CIGAR D reference bases.",
      "description": "Reference-consuming deletions in primary alignments, from CIGAR D. A deletion is not automatically a sequencing or assembler error.",
      "label": "Mapped reference deletion bases",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "unspecified",
      "unit": "nt"
    },
    "final_contig_31mer_redundancy_fraction": {
      "denominator": "Repeated 31-mer instances / eligible 31-mer instances.",
      "description": "Proportion of assembled 31-mer instances repeated in other contigs. A heuristic indicator of redundancy, not misassembly.",
      "label": "Redundant contig 31-mer fraction",
      "stage": "MiCall assembler output",
      "suggested_direction": "lower",
      "unit": "fraction"
    },
    "final_contig_count": {
      "denominator": "Number of final contig records.",
      "description": "Number of assembled contigs passed to downstream MiCall processing. Neither more nor fewer alone proves correctness.",
      "label": "Final contig count",
      "stage": "MiCall assembler output",
      "suggested_direction": "unspecified",
      "unit": "contigs"
    },
    "final_contig_total_bases": {
      "denominator": "Sum of assembled contig sequence lengths.",
      "description": "Sum of lengths of all final assembled contigs. Overlapping and duplicate segments are counted repeatedly.",
      "label": "Total contig bases",
      "stage": "MiCall assembler output",
      "suggested_direction": "unspecified",
      "unit": "nt"
    },
    "inserted_bases": {
      "denominator": "Count of CIGAR I query bases.",
      "description": "Nucleotide insertions in primary read alignments, from CIGAR I. True biological indels cannot be classified as errors from this alone.",
      "label": "Mapped primary-read insertion bases",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "unspecified",
      "unit": "nt"
    },
    "mapq_zero": {
      "denominator": "Count of mapped primary records with MAPQ 0.",
      "description": "Mapped primary reads assigned MAPQ 0, which indicates no mapping confidence on the SAM scale.",
      "label": "Primary reads with MAPQ 0",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "reads"
    },
    "mean_known_mapq": {
      "denominator": "Sum of known primary MAPQ / primary records with MAPQ != 255.",
      "description": "Mean mapping quality among mapped primary alignment records with known MAPQ. SAM MAPQ 255 denotes unknown and is excluded.",
      "label": "Mean known MAPQ",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "higher",
      "unit": "phred score"
    },
    "nuc_q15_covered_fraction": {
      "denominator": "Q15-covered positions / positions examined.",
      "description": "Fraction of expected positions with supported Q15 nucleotide coverage, as available in MiCall's nucleotide summary.",
      "label": "Q15 breadth",
      "stage": "MiCall nucleotide summary",
      "suggested_direction": "higher",
      "unit": "fraction"
    },
    "nuc_q15_mean_depth": {
      "denominator": "Mean depth over represented Q15 nucleotide positions.",
      "description": "Average nucleotide read depth among the positions represented in MiCall's quality-cutoff-15 nucleotide summary.",
      "label": "Mean Q15 depth",
      "stage": "MiCall nucleotide summary",
      "suggested_direction": "higher",
      "unit": "reads / site"
    },
    "nuc_soft_clips_count": {
      "denominator": "Sum or deduplicated per-position nuc.csv clip aggregate.",
      "description": "MiCall's aggregated per-position nuc.csv clip count. This quantity has different inclusion and duplication rules than SAM soft clips.",
      "label": "MiCall per-position clip aggregate",
      "stage": "MiCall nucleotide summary",
      "suggested_direction": "unspecified",
      "unit": "count"
    },
    "primary_mapped": {
      "denominator": "Count of primary mapped alignment records.",
      "description": "Primary alignment records marked mapped in the SAM. Secondary and supplementary records are excluded; records need not be unique molecules.",
      "label": "Primary mapped reads",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "higher",
      "unit": "reads"
    },
    "primary_mapped_fraction": {
      "denominator": "Mapped primary / (mapped + unmapped primary records).",
      "description": "Fraction of primary SAM alignment records marked mapped; this is a read-record rate, not a genome reconstruction score.",
      "label": "Primary mapped read fraction",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "higher",
      "unit": "fraction"
    },
    "primary_unmapped": {
      "denominator": "Count of primary unmapped alignment records.",
      "description": "Primary alignment records carrying the SAM unmapped flag. Not the same as a count of unmatched original read pairs.",
      "label": "Primary unmapped reads",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "reads"
    },
    "region_concordance_mean": {
      "denominator": "Mean of valid region concordance percentages.",
      "description": "Mean MiCall regional concordance between the final result and the aligned reference panel, evaluated only after assembly.",
      "label": "Mean region concordance",
      "stage": "MiCall regional concordance",
      "suggested_direction": "higher",
      "unit": "percentage"
    },
    "secondary": {
      "denominator": "Count of SAM secondary alignment records.",
      "description": "SAM secondary alignments, including alternative placements. A large count can reflect legitimate multi-mapping rather than errors.",
      "label": "Secondary alignments",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "unspecified",
      "unit": "records"
    },
    "soft_clip_events": {
      "denominator": "Count; per 1,000 mapped primary reads is available separately.",
      "description": "CIGAR S operations on primary mapped reads. One read can contribute a left and right clip event.",
      "label": "Soft-clip events",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "events"
    },
    "soft_clip_events_per_1000_primary_mapped": {
      "denominator": "1,000 \u00d7 clip events / mapped primary reads.",
      "description": "Frequency of individual left/right CIGAR S clipping operations among mapped primary alignment records.",
      "label": "Clip events per 1,000 mapped reads",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "events / 1000 reads"
    },
    "soft_clipped_bases": {
      "denominator": "Count; normalized per 1,000 mapped sequenced bases separately.",
      "description": "Total nucleotide bases excluded by CIGAR S operations on primary mapped alignment records.",
      "label": "Soft-clipped bases",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "nt"
    },
    "soft_clipped_bases_per_1000_read_bases": {
      "denominator": "1,000 \u00d7 clipped bases / mapped primary-read bases.",
      "description": "Total soft-clipped nucleotides normalized by mapped primary-read sequence bases. A shorter clipped fraction is not necessarily biologically more accurate.",
      "label": "Clipped bases per 1,000 mapped read bases",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "nt / 1000 nt"
    },
    "soft_clipped_reads": {
      "denominator": "Count; mapped primary alignment records are the reference population.",
      "description": "Primary mapped alignment records with at least one CIGAR S operation. Both ends of the same read count once here.",
      "label": "Soft-clipped primary reads",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "lower",
      "unit": "reads"
    },
    "supplementary": {
      "denominator": "Count of SAM supplementary alignment records.",
      "description": "SAM supplementary alignments, often associated with split mappings. Whether more or fewer is desirable depends on the sample.",
      "label": "Supplementary alignments",
      "stage": "Read-to-contig SAM alignment",
      "suggested_direction": "unspecified",
      "unit": "records"
    }
  },
